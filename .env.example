# 'static' reads the generated JSON in public/data (the default and, today, the
# only implementation). 'api' would target a backend — see src/data/datasource/.
VITE_DATA_SOURCE=static
# VITE_API_BASE_URL=

# ── "Ask the data" assistant ─────────────────────────────────────────────────
# Copy to .env.local (git-ignored) to run it with `npm run dev`. See
# server/README.md for what each setting does and how to deploy it on AWS.

# Server side — never exposed to the browser.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Only for a reasoning model: low | medium | high
# OPENAI_REASONING_EFFORT=

# Production build — shows the panel. Leave unset where the endpoint isn't
# deployed. `npm run dev` always shows it.
# VITE_ASSISTANT_ENABLED=true
